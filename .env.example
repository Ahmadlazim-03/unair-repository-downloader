# Public frontend setting. Never put passwords or backend secrets in VITE_*.
VITE_API_URL=http://127.0.0.1:8787
# Backend environment (Docker / server), not Vercel frontend variables:
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# existing = use this machine's connected VPN; portal = userspace Wireproxy
VPN_MODE=existing
# Optional absolute path when wireproxy is not on PATH (e.g. local testing).
WIREPROXY_BIN=
# REQUIRED in portal/public mode: shared invitation code to limit backend use.
# Users enter it in the website; do not prefix this variable with VITE_.
APP_ACCESS_KEY=
JOB_TTL_SECONDS=1800
MAX_PAGES=500
MAX_TOTAL_MB=250
